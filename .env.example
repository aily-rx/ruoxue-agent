# ============================================================================
# Ruoxue — 环境变量配置
# ============================================================================
# 复制为 .env 并填入实际值：  cp .env.example .env
# ============================================================================

# --- DeepSeek LLM (必填) ---
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# --- 服务器 ---
RUOXUE_HOST=0.0.0.0
RUOXUE_PORT=8000

# --- 会话 ---
MAX_HISTORY_TURNS=20

# --- TTS (离线语音合成，使用系统自带语音) ---
# Windows: Microsoft Huihui，macOS/Linux: 系统默认语音
# 完全离线，零配置，零依赖

# --- Agent 工具 ---
# Tavily Search API（用于网页搜索工具，国内可直接访问）
# 免费额度：1000 次/月，注册地址：https://tavily.com
TAVILY_API_KEY=tvly-your-api-key-here

# --- ASR (SenseVoice ONNX, 需先下载模型) ---
# ASR_MODEL_DIR=model_assets/asr/sensevoice-small-int8
