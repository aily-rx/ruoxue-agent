# ============================================================================
# Ruoxue — 环境变量配置
# ============================================================================
# 复制为 .env 并填入实际值：  cp .env.example .env
# ============================================================================

# --- DeepSeek LLM (必填) ---
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# --- 服务器 ---
RUOXUE_HOST=0.0.0.0
RUOXUE_PORT=8000

# --- 会话 ---
MAX_HISTORY_TURNS=20

# --- TTS (Edge TTS, 免费无需 Key) ---
TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_PROXY=http://127.0.0.1:7890          # 如果 Edge TTS 被墙

# --- ASR (SenseVoice ONNX, 需先下载模型) ---
# ASR_MODEL_DIR=model_assets/asr/sensevoice-small-int8

# --- 天气代理 (可选，国内用户配置代理后天气工具更稳定) ---
# WEATHER_PROXY=http://127.0.0.1:7890
